# Supabase (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Mobile (Expo) — same values, EXPO_PUBLIC_ prefix required
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web (Next.js) — same values, NEXT_PUBLIC_ prefix required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# eBay OAuth (Supabase function secrets — set via `supabase secrets set ...`,
# never committed to git). See docs/ebay-oauth-setup.md for full instructions.
# -----------------------------------------------------------------------------
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id
EBAY_RUNAME=Your-Ebay-Ru-Name-From-Developer-Dashboard
# `production` | `sandbox` — defaults to `production`
EBAY_OAUTH_ENV=production
# Mobile deep-link scheme used by the callback function to redirect back into
# the app. Must match `expo.scheme` in apps/mobile/app.json.
EBAY_OAUTH_RETURN_SCHEME=nexissue
# Optional override of requested scopes (space-separated full eBay scope URLs).
# Leave blank to use the defaults defined in supabase/functions/_shared/ebay.ts
EBAY_OAUTH_SCOPES=

# AES-256-GCM key for encrypting OAuth tokens at rest. Generate once with:
#   openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=base64-of-32-random-bytes

# eBay listing (listing-create edge function — optional overrides)
# Category 259104 = Collectible Comic Books
EBAY_CATEGORY_ID=259104
# If unset, the function auto-fetches your first policy from the Account API
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# GoCollect pricing (pricing-refresh edge function — set via `supabase secrets set`)
GOCOLLECT_API_KEY=your-gocollect-api-key
# eBay Finding API App ID (a.k.a. Client ID). Used by pricing-refresh for sold comps via
# findCompletedItems. Optional — falls back to EBAY_CLIENT_ID.
EBAY_APP_ID=
# Optional: production Browse keys when EBAY_OAUTH_ENV=sandbox (OAuth) but you want real active comps
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=
EBAY_BROWSE_ENV=production
