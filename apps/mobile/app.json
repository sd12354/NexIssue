{
  "expo": {
    "name": "NexIssue",
    "slug": "nexissue",
    "scheme": "nexissue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#252878"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NexIssue uses the camera to scan slab QR codes and photograph label text for OCR."
      },
      "bundleIdentifier": "com.anonymous.nexissue"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#252878"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NexIssue to scan slab QR codes and capture label photos."
        }
      ],
      "expo-web-browser"
    ],
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
