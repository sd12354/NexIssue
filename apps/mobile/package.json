{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:clear": "expo start --dev-client -c",
    "dev:go": "expo start",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node scripts/ios-pod-profile.mjs sim && pnpm ios:pods && expo run:ios",
    "ios:pods": "pod install --project-directory=ios",
    "ios:run": "pnpm ios",
    "ios:device": "node scripts/ios-pod-profile.mjs device && pnpm ios:pods && expo run:ios --device",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@babel/runtime": "^7.29.2",
    "@expo/vector-icons": "^15.1.1",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "hoist-non-react-statics": "^3.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "exclude": [
        "expo-image",
        "@infinitered/react-native-mlkit-core",
        "@infinitered/react-native-mlkit-text-recognition"
      ]
    }
  }
}
